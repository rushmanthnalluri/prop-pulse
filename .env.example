# PropPulse — example environment configuration (copy to .env and adjust).
# No secrets belong in this file. Paths are repo-relative (see ml/paths.py).
#
# The backend image (docker/backend.Dockerfile) bakes these same app keys in
# as ENV defaults; compose's env_file (.env) overrides them. The Dockerfile
# also sets PYTHONUNBUFFERED / PYTHONDONTWRITEBYTECODE / PIP_NO_CACHE_DIR /
# PIP_DISABLE_PIP_VERSION_CHECK — image-build hygiene only, not app settings,
# so they are intentionally absent here.

# Directory containing trained model artifacts (models/).
MODEL_DIR=models

# Directory containing the dataset tree (data/{raw,interim,processed,external}).
DATA_DIR=data

# MLflow tracking URI. Leave empty to use the local file store at ./mlruns
# (see ml/tracking.py). Example for a real server: http://localhost:5000
MLFLOW_TRACKING_URI=

# Required by MLflow 3.15 to permit a local file store (SPEC §14);
# ml/tracking.py also sets this in-process, export it for bare-metal mlflow CLI use.
MLFLOW_ALLOW_FILE_STORE=true

# Frontend → backend base URL (Vite).
VITE_API_URL=http://localhost:8000

# API abuse controls (per direct client peer, in-process rolling windows).
# Health/readiness and browser CORS preflight are exempt. Never set client identity
# from raw X-Forwarded-For; counters are local to one process and reset on restart.
PROPULSE_RATE_LIMIT_PREDICTION=30
PROPULSE_RATE_WINDOW_PREDICTION=60
PROPULSE_RATE_LIMIT_WORKFLOW_WRITE=8
PROPULSE_RATE_WINDOW_WORKFLOW_WRITE=60
PROPULSE_RATE_LIMIT_TRAINING=2
PROPULSE_RATE_WINDOW_TRAINING=60
PROPULSE_RATE_LIMIT_GENERAL=120
PROPULSE_RATE_WINDOW_GENERAL=60

# Logging verbosity: DEBUG | INFO | WARNING | ERROR. Drives the root logger
# (app loggers) via logging.basicConfig in backend/app/main.py; the image CMD
# also derives uvicorn's own --log-level from it (lowercased for uvicorn's
# case-sensitive CLI), so one variable controls app and server logs alike.
LOG_LEVEL=INFO

# JSONL file where the backend logs every prediction (best-effort, rotating-safe).
PREDICTION_LOG_PATH=logs/predictions.jsonl

# PSI threshold at which a feature is considered drifted (warn threshold is a
# fixed 0.1 — ml/monitoring/psi.py PSI_WARN_THRESHOLD — it does not scale with
# this override).
DRIFT_PSI_THRESHOLD=0.2

# Comma-separated browser origins the backend allows via CORS
# (Vite dev server :5173, vite preview :4173, docker-compose frontend :8080).
# Not baked into the image as an ENV default — the running container reads it
# from .env via compose env_file; the in-code default matches this list.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080
